{
	"compilerOptions": {
		/* Base Options: */
		"esModuleInterop": true,
		"skipLibCheck": true,
		"target": "es2022",
		"allowJs": true,
		"resolveJsonModule": true,
		"moduleDetection": "force",
		"isolatedModules": true,
		/* Strictness */
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"checkJs": true,
		/* Bundled projects */
		"lib": ["dom", "dom.iterable", "ES2022"],
		"noEmit": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"plugins": [
			{
				"name": "next"
			}
		],
		"incremental": true,
		/* Path Aliases */
		/* React types: libraries in pnpm's global virtual store cannot reach the
		   app's @types/react by walking up, so their React imports would degrade
		   to `any`. Every React import resolves to the one declared copy. */
		"paths": {
			"react": ["./node_modules/@types/react"],
			"react/*": ["./node_modules/@types/react/*"],
			"react-dom": ["./node_modules/@types/react-dom"],
			"react-dom/*": ["./node_modules/@types/react-dom/*"],
			"@/*": ["./*"],
			"@dokploy/server/*": ["../../packages/server/src/*"]
		}
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		"**/*.cjs",
		"**/*.js",
		".next/types/**/*.ts",
		"env.js",
		"next.config.mjs"
	],
	"exclude": [
		"node_modules",
		"dokploy",
		"config",
		"dist",
		"webpack.config.server.js",
		"migration.ts",
		"setup.ts"
	]
}
